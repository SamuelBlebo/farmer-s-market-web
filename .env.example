# Postgres (local docker: docker run --name fm-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farmers_market?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# Cloudinary (unsigned upload preset for browser uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="farmers_market_unsigned"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Shown in the pre-filled WhatsApp message
NEXT_PUBLIC_PLATFORM_NAME="Farmers Market"
