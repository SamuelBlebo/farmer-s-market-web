generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
enum Role {
  FARMER
  BUYER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ProductStatus {
  ACTIVE
  PAUSED
  SOLD
  REMOVED
}

// Listings are admin-approved before they reach the marketplace.
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WantedStatus {
  OPEN
  CLOSED
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// ---------- auth ----------
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  phone         String    @unique
  role          Role      @default(BUYER)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Updated opportunistically on authenticated requests — see cache()-wrapped
  // currentUser() in server/authz.ts. Not a precise online/offline signal.
  lastActiveAt DateTime?

  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
  favorites     Favorite[]
  reports       Report[]       @relation("ReportAuthor")
  accounts      Account[]
  sessions      Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- profiles ----------
model FarmerProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  farmName     String
  description  String?
  region       String
  town         String
  phone        String
  whatsapp     String
  verification VerificationStatus @default(UNVERIFIED)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([region])
  @@index([verification])
}

model BuyerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  description  String?
  region       String
  town         String
  phone        String
  whatsapp     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wanted WantedListing[]

  @@index([region])
}

// ---------- marketplace ----------
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  emoji     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]

  @@index([active, sortOrder])
}

model Product {
  id                  String           @id @default(cuid())
  farmerId            String
  categoryId          String
  name                String
  description         String?
  priceMinor          Int
  currency            String           @default("GHS")
  unit                String
  quantity            Decimal          @db.Decimal(12, 2)
  initialQty          Decimal          @db.Decimal(12, 2)
  region              String
  town                String
  status              ProductStatus    @default(ACTIVE)
  moderation          ModerationStatus @default(PENDING)
  // Null = no scheduled harvest (an ordinary, continuously-available listing).
  // Set = the marketplace/dashboard derive an "upcoming harvest" vs "available
  // now" display from this instead of a separate stored lifecycle field.
  expectedHarvestDate DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  farmer    FarmerProfile    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  favorites Favorite[]
  reports   Report[]

  @@index([status, moderation, createdAt])
  @@index([categoryId, status])
  @@index([region, status])
  @@index([farmerId])
  @@index([priceMinor])
}

// Optional per-product size/grade options (e.g. Small/Medium/Large tomatoes)
// with their own price. The base Product.priceMinor stays the listing's
// headline price; variants are additive, not a replacement.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  priceMinor Int
  quantity   Decimal? @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model WantedListing {
  id          String           @id @default(cuid())
  buyerId     String
  productName String
  categoryId  String?
  quantity    String
  region      String
  town        String
  neededBy    DateTime?
  description String?
  status      WantedStatus     @default(OPEN)
  // Admin-approved before it's publicly visible — same enum and flow as Product.moderation.
  moderation  ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  buyer BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([status, moderation, createdAt])
  @@index([region])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Report {
  id         String       @id @default(cuid())
  productId  String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId])
}
