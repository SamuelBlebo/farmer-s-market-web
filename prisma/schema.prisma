generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
enum Role {
  FARMER
  BUYER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ProductStatus {
  ACTIVE
  PAUSED
  SOLD
  REMOVED
}

// Listings are admin-approved before they reach the marketplace.
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WantedStatus {
  OPEN
  CLOSED
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum AnalyticsEventType {
  PRODUCT_VIEWED
  FARMER_VIEWED
  FARMER_FOLLOWED
  LISTING_SAVED
  WHATSAPP_CLICKED
  CALL_CLICKED
  SEARCH_PERFORMED
}

enum NotificationType {
  NEW_LISTING
  HARVEST_AVAILABLE
}

enum FeedbackStatus {
  OPEN
  REVIEWED
}

// ---------- auth ----------
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  phone         String    @unique
  role          Role      @default(BUYER)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Updated opportunistically on authenticated requests — see cache()-wrapped
  // currentUser() in server/authz.ts. Not a precise online/offline signal.
  lastActiveAt DateTime?

  // Last 10 viewed product ids, most-recent-first. A plain scalar array on the
  // existing model rather than a new table — this is browsing history, not a
  // relation anything else needs to join against. Guests get the same 10-item
  // recency window client-side, in localStorage.
  recentlyViewedIds String[] @default([])

  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
  favorites     Favorite[]
  reports       Report[]       @relation("ReportAuthor")
  accounts      Account[]
  sessions      Session[]

  // A buyer follows a farmer's User row (not FarmerProfile) — see FarmFollow.
  followedFarms   FarmFollow[]     @relation("BuyerFollow")
  followers       FarmFollow[]     @relation("FarmerFollow")
  notifications   Notification[]
  analyticsEvents AnalyticsEvent[]
  feedback        Feedback[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- profiles ----------
model FarmerProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  farmName     String
  description  String?
  coverImage   String?
  region       String
  town         String
  phone        String
  whatsapp     String
  verification VerificationStatus @default(UNVERIFIED)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([region])
  @@index([verification])
}

model BuyerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  description  String?
  region       String
  town         String
  phone        String
  whatsapp     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wanted WantedListing[]

  @@index([region])
}

// ---------- marketplace ----------
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  emoji     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]

  @@index([active, sortOrder])
}

model Product {
  id                  String           @id @default(cuid())
  farmerId            String
  categoryId          String
  name                String
  description         String?
  priceMinor          Int
  currency            String           @default("GHS")
  unit                String
  quantity            Decimal          @db.Decimal(12, 2)
  initialQty          Decimal          @db.Decimal(12, 2)
  region              String
  town                String
  status              ProductStatus    @default(ACTIVE)
  moderation          ModerationStatus @default(PENDING)
  // Null = no scheduled harvest (an ordinary, continuously-available listing).
  // Set = the marketplace/dashboard derive an "upcoming harvest" vs "available
  // now" display from this instead of a separate stored lifecycle field.
  expectedHarvestDate DateTime?
  // Delivery is opt-in per listing — false/null means pickup only.
  deliveryAvailable   Boolean          @default(false)
  deliveryRadiusKm    Int?
  deliveryFeeMinor    Int?
  // Admin editorial pick — shown in the homepage's Featured section.
  featured            Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  farmer    FarmerProfile    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  favorites     Favorite[]
  reports       Report[]
  notifications Notification[]

  @@index([status, moderation, createdAt])
  @@index([featured, status, moderation])
  @@index([categoryId, status])
  @@index([region, status])
  @@index([farmerId])
  @@index([priceMinor])
}

// Optional per-product size/grade options (e.g. Small/Medium/Large tomatoes)
// with their own price. The base Product.priceMinor stays the listing's
// headline price; variants are additive, not a replacement.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  priceMinor Int
  quantity   Decimal? @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model WantedListing {
  id          String           @id @default(cuid())
  buyerId     String
  productName String
  categoryId  String?
  quantity    String
  region      String
  town        String
  neededBy    DateTime?
  description String?
  status      WantedStatus     @default(OPEN)
  // Admin-approved before it's publicly visible — same enum and flow as Product.moderation.
  moderation  ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  buyer BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([status, moderation, createdAt])
  @@index([region])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// A buyer following a farmer. Keyed off User rather than FarmerProfile on
// both sides — buyerId is always a BUYER's User.id, farmerId is always a
// FARMER's User.id (never a FarmerProfile.id); callers join to FarmerProfile
// separately where they need storefront fields.
model FarmFollow {
  id        String   @id @default(cuid())
  buyerId   String
  farmerId  String
  createdAt DateTime @default(now())

  buyer  User @relation("BuyerFollow", fields: [buyerId], references: [id], onDelete: Cascade)
  farmer User @relation("FarmerFollow", fields: [farmerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, farmerId])
  @@index([farmerId])
}

// Fanned out one row per follower when a followed farmer's listing is
// approved or a scheduled harvest becomes available. No push/websocket
// layer — the bell badge and /notifications page just read this table.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  productId String?
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([productId, type])
}

// Real, best-effort behavior tracking — never invented. userId is null for
// guest-originated events (e.g. an anonymous search); entityId is whatever
// the event is about (a product id, a farmer id), left null when not
// applicable. metadata is a short free-text field (e.g. a search query).
model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  userId    String?
  entityId  String?
  metadata  String?
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  productId  String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId])
}

// Free-text feedback from the floating widget or the /support page — deliberately
// not tied to a product/farmer, unlike Report. userId is null for guest submissions.
model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  message   String
  // Path the widget was opened from (e.g. "/products/abc123") — context for admin triage.
  page      String?
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
